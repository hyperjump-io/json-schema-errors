{
  "$schema": "../test-suite.schema.json",

  "description": "The propertyNames keyword",
  "tests": [
    {
      "description": "propertyNames",
      "compatibility": "6",
      "schema": {
        "propertyNames": { "minLength": 5 }
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "minLength-message",
          "messageParams": {
            "minLength": 5
          },
          "instanceLocation": "#*/foo",
          "schemaLocations": ["#/propertyNames/minLength"]
        }
      ]
    },
    {
      "description": "propertyNames without star notation",
      "compatibility": "6",
      "schema": {
        "propertyNames": { "minLength": 5 }
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "minLength-message",
          "messageParams": {
            "minLength": 5
          },
          "instanceLocation": "#*/foo",
          "schemaLocations": ["#/propertyNames/minLength"]
        }
      ]
    },
    {
      "description": "propertyNames on a non-object",
      "compatibility": "6",
      "schema": {
        "propertyNames": { "minLength": 5 }
      },
      "instance": 42,
      "errors": []
    },
    {
      "description": "propertyNames false",
      "compatibility": "6",
      "schema": {
        "propertyNames": false
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "boolean-schema-message",
          "instanceLocation": "#*/foo",
          "schemaLocations": ["#/propertyNames"]
        }
      ]
    },
    {
      "description": "propertyNames with a false schema in allOf",
      "compatibility": "6",
      "schema": {
        "propertyNames": { "allOf": [false] }
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "boolean-schema-message",
          "instanceLocation": "#*/foo",
          "schemaLocations": ["#/propertyNames/allOf/0"]
        }
      ]
    },
    {
      "description": "propertyNames with a $ref to a false schema",
      "compatibility": "6",
      "schema": {
        "propertyNames": { "$ref": "#/$defs/never" },
        "$defs": {
          "never": false
        }
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "boolean-schema-message",
          "instanceLocation": "#*/foo",
          "schemaLocations": ["#/$defs/never"]
        }
      ]
    },
    {
      "description": "propertyNames false in anyOf",
      "compatibility": "6",
      "schema": {
        "anyOf": [
          { "propertyNames": false },
          { "type": "string" }
        ]
      },
      "instance": { "foo": 42 },
      "errors": [
        {
          "messageId": "anyOf-message",
          "alternatives": [
            [
              {
                "messageId": "boolean-schema-message",
                "instanceLocation": "#*/foo",
                "schemaLocations": ["#/anyOf/0/propertyNames"]
              }
            ],
            [
              {
                "messageId": "type-message",
                "messageParams": {
                  "count": 1,
                  "type": "string",
                  "expectedTypes": { "or": ["string"] }
                },
                "instanceLocation": "#",
                "schemaLocations": ["#/anyOf/1/type"]
              }
            ]
          ],
          "instanceLocation": "#",
          "schemaLocations": ["#/anyOf"]
        }
      ]
    },
    {
      "description": "propertyNames pass",
      "schema": {
        "propertyNames": { "minLength": 5 }
      },
      "instance": { "foobar": 42 },
      "errors": []
    }
  ]
}
